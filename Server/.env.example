# Copy to Server/.env and fill in real values. Never commit the real file.

# MongoDB connection string
MONGODB_URI="mongodb://127.0.0.1:27017/cryptotrack"

# Port the Express API listens on
PORT=3000

# Allowed CORS origin. Match your Vite dev server locally.
CLIENT="http://localhost:5173"

# Secret used to sign JWTs. Generate one, for example:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-string"
